---
import "../styles/taban.css";
import "../styles/veri-tablo.css";
import { durum, tarih } from "../lib/veri";
interface Props { baslik: string; aciklama: string; yol: string; jsonld?: object }
const { baslik, aciklama, yol, jsonld } = Astro.props;
import manifest from "../../../yayin/api/v1/manifest.json";
const kanonik = new URL(yol, Astro.site).href;
const menu = [["/", "Panorama"], ["/gezgin", "Veri gezgini"], ["/karsilastir", "Karşılaştır"], ["/kaynaklar", "Kaynaklar"], ["/api", "API"], ["/yontem", "Yöntem"], ["/koray-oner", "Koray Öner"]];
const etkin = (h: string) => (h === "/" ? yol === "/" : yol.startsWith(h));
// Veri durumu derlemede durum.json'dan (site her veri commit'inde yeniden derlenir).
const d = durum();
const sorun = d ? d.ozet.hatali + d.ozet.geciken : 0;
const kisaTarih = d ? tarih(d.son_kontrol).replace(/ \d{4}$/, "") : null;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="veri-release" content={manifest.release_id}>
  <meta name="referrer" content="no-referrer">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{baslik}</title>
  <meta name="description" content={aciklama}>
  <link rel="canonical" href={kanonik}>
  <meta property="og:site_name" content="Türkiye Verisi">
  <meta property="og:type" content="website">
  <meta property="og:title" content={baslik}>
  <meta property="og:description" content={aciklama}>
  <meta property="og:url" content={kanonik}>
  <meta property="og:locale" content="tr_TR">
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" type="image/x-icon">
  <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png">
  <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <meta name="theme-color" content="#0e7c66" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)">
  <script is:inline src="/tema-erken.js"></script>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="atla" href="#ana">İçeriğe geç</a>
  <header class="ust">
    <div class="sar ust-ic">
      <a class="marka" href="/" aria-label="Türkiye Verisi ana sayfa">
        <img class="marka-isaret" src="/favicon.svg" width="32" height="32" alt="">
        <span>Türkiye <span class="marka-vurgu">Verisi</span></span>
      </a>
      <div class="ust-arac">
        {d && (
          <a class="ust-durum" href="/kaynaklar" title={`Son veri kontrolü ${tarih(d.son_kontrol)}; ${d.ozet.yayinda}/${d.ozet.seri} seri yayında`}>
            <span class:list={["nokta", sorun ? "nokta--uyari" : "nokta--iyi"]} aria-hidden="true"></span>
            <span>Veri {kisaTarih}{sorun > 0 && <span class="ust-sorun"> · {sorun} uyarı</span>}</span>
          </a>
        )}
        <button type="button" id="tema-dugme" class="tema-dugme" aria-label="Tema: Sistem. Değiştirmek için basın">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" /><path d="M8 1.8a6.2 6.2 0 0 1 0 12.4z" /></svg>
          <span class="tema-ad">Sistem</span>
        </button>
      </div>
      <nav aria-label="Birincil">
        <ul>{menu.map(([h, a]) => <li><a href={h} aria-current={etkin(h) ? "page" : undefined}>{a}</a></li>)}</ul>
      </nav>
    </div>
  </header>
  <main id="ana" tabindex="-1"><slot /></main>
  <footer class="alt">
    <div class="sar alt-ic">
      <div class="alt-baglantilar">
        <p>Hazırlayan <a href="/koray-oner">Koray Öner</a></p>
        <ul aria-label="Site bağlantıları">
          <li><a href="https://korayoner.dev/">korayoner.dev</a></li>
          <li><a href="https://github.com/onerkoray/veri-korayoner">Kaynak kod</a></li>
          <li><a href="/gizlilik">Gizlilik ve KVKK</a></li>
        </ul>
      </div>
      <p>Kurumlardan bağımsızdır; resmî kurum sitesi değildir. Her seri kendi kaynağının lisansıyla yayımlanır; kullanırken asıl kaynağa atıf yapın. Yatırım tavsiyesi değildir.</p>
    </div>
  </footer>
  <script>
    import { grafikHareketi, konumSeridi } from "../lib/hareket";
    grafikHareketi();
    konumSeridi();
  </script>
</body>
</html>
<style>
  .atla { position: absolute; z-index: 50; inset: .5rem auto auto .5rem; transform: translateY(-150%);
    padding: .55rem .8rem; border-radius: .4rem; background: var(--metin); color: var(--bg); }
  .atla:focus { transform: none; }
  .atla:hover { color: var(--bg); }
  main:focus { outline: none; }
  .ust { border-bottom: 1px solid var(--cizgi); background: var(--yuzey); }
  .ust-ic { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 60px; flex-wrap: wrap; }
  .marka { display: inline-flex; align-items: center; gap: .6rem; font-weight: 750; letter-spacing: -.025em; text-decoration: none; white-space: nowrap; }
  .marka-isaret { flex: none; display: block; }
  .marka-vurgu { color: var(--marka); }
  /* Masaüstü: marka · menü · araçlar tek satır. Telefon: marka + araçlar, altında yatay kayan menü. */
  .ust-arac { order: 3; display: flex; align-items: center; gap: .5rem; }
  nav { order: 2; min-width: 0; }
  nav ul { display: flex; gap: .3rem; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--soluk); display: inline-flex; align-items: center; min-height: 2.25rem; font-size: .9rem; padding: .3rem .55rem; border-radius: .45rem; white-space: nowrap; }
  nav a[aria-current="page"] { color: var(--metin); background: var(--yuzey-2); font-weight: 700; }
  nav a:hover { background: var(--yuzey-2); color: var(--metin); }
  .ust-durum { display: inline-flex; align-items: center; gap: .4rem; font: 600 .7rem/1 var(--mono); letter-spacing: .03em; color: var(--soluk);
    text-decoration: none; padding: .45rem .6rem; border: 1px solid var(--cizgi); border-radius: .45rem; white-space: nowrap; }
  .ust-durum:hover { color: var(--metin); border-color: var(--metin); }
  .nokta { width: .5rem; height: .5rem; border-radius: 50%; }
  .nokta--iyi { background: var(--dv-iyi); }
  .nokta--uyari { background: var(--dv-kotu); }
  .tema-dugme { visibility: hidden; display: inline-flex; align-items: center; gap: .4rem; min-height: 2.25rem; padding: .35rem .6rem;
    font: 600 .7rem/1 var(--mono); color: var(--soluk); background: none; border: 1px solid var(--cizgi); border-radius: .45rem; cursor: pointer; }
  .tema-dugme:hover { color: var(--metin); border-color: var(--metin); }
  .tema-dugme svg circle { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .tema-dugme svg path { fill: currentColor; }
  @media (max-width: 70rem) { .ust-durum { display: none; } }
  @media (max-width: 56rem) {
    .ust-ic { padding-top: .5rem; gap: .5rem 1rem; }
    .ust-arac { order: 2; margin-left: auto; }
    nav { order: 3; flex-basis: 100%; }
    nav ul { overflow-x: auto; scrollbar-width: none; gap: .25rem; padding: .18rem .15rem .5rem;
      mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent); }
    nav ul::-webkit-scrollbar { display: none; }
    nav li:last-child { padding-right: 2rem; }
  }
  main { min-height: 70vh; }
  .alt { border-top: 1px solid var(--cizgi); margin-top: 4rem; padding-block: 2rem; color: var(--soluk); font-size: .85rem; }
  .alt p { margin: .3rem 0; max-width: 80ch; }
  .alt-baglantilar, .alt-baglantilar ul { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem 1.25rem; }
  .alt-baglantilar { justify-content: space-between; margin-bottom: .75rem; }
  .alt-baglantilar ul { list-style: none; margin: 0; padding: 0; }
  .alt-baglantilar a { display: inline-block; padding-block: .35rem; }
</style>
