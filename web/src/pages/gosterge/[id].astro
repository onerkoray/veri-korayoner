---
import Taban from "../../layouts/Taban.astro";
import SeriGrafik from "../../components/SeriGrafik.astro";
import EmsalGrafik from "../../components/EmsalGrafik.astro";
import Serit from "../../components/Serit.astro";
import { seriler, degerTuru, deger, degisim, son, dolu, tarih, birimAdi, siklikAdi, TEMA, emsal, emsalNoktalari, noktalar, ulkeAdi, durum, degisiklikler, baglamlar, farkYaz, gozlemEtiketi, type Seri } from "../../lib/veri";
import { oku, sirala, siraCumlesi, donemAdi, tarihselKiyas, yillikDegisimler, type YillikFark } from "../../lib/okuma.ts";
import { KISI_REF } from "../../lib/kimlik";

export function getStaticPaths() {
  return seriler().map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Seri };
const sn = son(s), dg = degisim(s), d = dolu(s);
const yaz = (v: number) => deger(s, v);
const okuma = oku(noktalar(s), s.siklik, s.birim, yaz);
const em = emsal(s.id);
const emN = em ? emsalNoktalari(em) : null;
const sira = emN ? sirala(noktalar(s), emN) : null;
const yol = `/gosterge/${s.id}`;
const api = s.izin.api ? `/api/v1/seri/${s.id}.json` : null;
const csv = s.izin.indirme ? `/api/v1/seri/${s.id}.csv` : null;
const asil = (s.kaynak_not ?? "").split(/[;\n]/)[0].replace(/,?\s*uri:.*$/, "").trim() || null;
const [akis, anahtar] = s.kaynak_kod.split("/");
const kaynakAdresi = ({
  world_bank: `https://data.worldbank.org/indicator/${s.kaynak_kod}?locations=TR`,
  bis: `https://data.bis.org/topics/${akis.replace(/^WS_/, "")}`,
  ecb: `https://data.ecb.europa.eu/data/datasets/${akis}/${akis}.${anahtar}`,
  eurostat: `https://ec.europa.eu/eurostat/databrowser/view/${akis}/default/table`,
} as Record<string, string>)[s.kaynak.id] ?? s.kaynak.adres;
const gunluk = s.siklik === "gunluk";
const tablo = s.gozlemler.slice().reverse().slice(0, gunluk ? 90 : undefined);
// Değer çubuğu: tablodaki değer aralığında sıfır merkezli (negatif sola). Yüzde birimiyle.
const tv = tablo.filter((g) => g.deger != null).map((g) => Number(g.deger));
const tlo = Math.min(0, ...tv), thi = Math.max(0, ...tv), tara = thi - tlo || 1;
const cubuk = (ham: string | null) => {
  if (ham == null) return undefined;
  const p = ((Number(ham) - tlo) / tara) * 100, z = (-tlo / tara) * 100;
  return `--b:${Math.min(p, z).toFixed(2)};--g:${Math.abs(p - z).toFixed(2)}`;
};
// Güncellik (durum.json), revizyon kaydı (degisiklikler.json), bir yıl önceye göre değişim.
const sd = durum()?.seriler.find((r) => r.id === s.id);
const olaylar = degisiklikler().filter((o) => o.seri === s.id);
const yillik = yillikDegisimler(noktalar(s), s.siklik, s.birim);
const yfYaz = (f: YillikFark) => {
  return f.ek === "%" ? farkYaz(f.fark, 1, "%") : `${farkYaz(f.fark, 1)} ${f.ek}`;
};
const gecmis = `https://github.com/onerkoray/veri-korayoner/commits/main/yayin/site-veri/seri/${s.id}.json`;
const gezginS = ({ aylik: "aylik", ceyreklik: "ceyreklik" } as Record<string, string>)[s.siklik] ?? "yillik";
const gezginAdres = s.izin.indirme ? `/gezgin#g=${s.id}${gezginS === "aylik" ? "" : `&s=${gezginS}`}${d[0] && (gezginS === "yillik" || Number(d[0].donem.slice(0, 4)) > 2010) && d[0].donem.slice(0, 4) !== "2010" ? `&b=${d[0].donem.slice(0, 4)}` : ""}` : null;   // yıllıkta bütün seri
const karsiAdres = s.izin.api && emsal(s.id) ? `/karsilastir#g=${s.id}` : null;
// Bağlam: kayıttaki okuma metni ve birlikte okunacak göstergeler (yayımlanmış olanlar).
const bg = baglamlar().get(s.id);
const tum = seriler();
const iliskili = (bg?.iliskili ?? []).map((i) => tum.find((x) => x.id === i)).filter((x): x is Seri => !!x);
const birlikte = [s, ...iliskili].filter((x) => x.izin.indirme).slice(0, 6);
const SKL = ["aylik", "ceyreklik", "yillik"];
const ortakS = SKL[Math.max(...birlikte.map((x) => Math.max(0, SKL.indexOf(x.siklik === "yariyillik" ? "yillik" : x.siklik))))];
const birlikteAdres = birlikte.length > 1 ? `/gezgin#g=${birlikte.map((x) => x.id).join(",")}${ortakS === "aylik" ? "" : `&s=${ortakS}`}` : null;
const jsonld = {
  "@context": "https://schema.org", "@type": "Dataset",
  name: `${s.baslik} — Türkiye`, description: `${s.baslik}, ${d[0]?.donem}–${sn?.donem}. Kaynak: ${s.kaynak.kurum} (${s.kaynak_kod}). ${okuma[0] ?? ""}`.trim(),
  url: new URL(yol, Astro.site).href, isAccessibleForFree: true, inLanguage: "tr",
  temporalCoverage: `${d[0]?.donem}/${sn?.donem}`, spatialCoverage: { "@type": "Country", name: "Türkiye" },
  ...(s.kaynak.lisans_kanit ? { license: s.kaynak.lisans_kanit } : {}),
  creator: { "@type": "Organization", name: s.kaynak.kurum, url: s.kaynak.adres },
  isBasedOn: kaynakAdresi,
  maintainer: KISI_REF, includedInDataCatalog: { "@type": "DataCatalog", name: "Türkiye Verisi", url: "https://veri.korayoner.dev/" },
  ...(s.kaynak_guncelleme ? { dateModified: s.kaynak_guncelleme } : {}),
  ...(api ? { distribution: [{ "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL(api, Astro.site).href },
    ...(csv ? [{ "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: new URL(csv, Astro.site).href }] : [])] } : {}),
};
const aciklama = `${s.baslik}: ${sn ? donemAdi(sn.donem) : ""} ${deger(s, sn?.deger ?? null)}. ${okuma[0] ?? ""} Kaynak ${s.kaynak.kurum}.`.replace(/\s+/g, " ").trim();
---
<Taban baslik={`${s.baslik} — Türkiye | Türkiye Verisi`} aciklama={aciklama} yol={yol} jsonld={jsonld}>
  <article class="sar">
    <nav class="iz" aria-label="Konum"><a href="/">Panorama</a> › {TEMA[s.tema] ?? s.tema}</nav>
    <header class="bas">
      <p class="etiket">{s.kaynak.kurum} · {s.kaynak_kod} · {siklikAdi(s.siklik)}</p>
      <h1>{s.baslik}</h1>
      {degerTuru(s) && <p class="hap hap--bilgi" title="Kaynak bu seriyi kendi modeliyle tahmin ediyor; içinde bulunulan yılın değeri projeksiyondur.">{degerTuru(s)} ({s.kaynak.kurum.replace(/\s*\(.*\)$/, "")})</p>}
      {s.birim === "yuzde-puan" && <p class="kucuk">Değer iki oranın farkıdır; yüzde değil yüzde puan olarak okunur.</p>}
      <p class="buyuk sayi">{deger(s, sn?.deger ?? null)} <span>{sn && donemAdi(sn.donem)}</span></p>
      <p class="guncellik">
        <span>Kaynağın son güncellemesi: {s.kaynak_guncelleme ? tarih(s.kaynak_guncelleme) : "bilinmiyor"}</span>
        {sd && <span>Son başarılı kontrol: {sd.son_basarili_kontrol ? tarih(sd.son_basarili_kontrol) : "bilinmiyor"}</span>}
        {sd?.gecikti && <span class="hap hap--uyari">tahmini eşik aşıldı</span>}
        {sd && sd.ardisik_hata > 0 && <span class="hap hap--uyari" title="Son çekim başarısız; önceki veri gösteriliyor">son çekim başarısız</span>}
      </p>
      {(gezginAdres || karsiAdres) && (
        <p class="eylem">
          {gezginAdres && <a href={gezginAdres}>Veri gezgininde aç →</a>}
          {karsiAdres && <a href={karsiAdres}>Emsallerle karşılaştır →</a>}
        </p>
      )}
      {dg && <p class="ozet">Bir önceki döneme göre {dg.metin}. {s.birim.startsWith("yuzde") || s.birim === "puan" ? "Fark puan olarak: son değer eksi önceki" + (s.birim === "puan" ? "; parantezde göreli değişim (son ÷ önceki − 1)." : ".") : s.birim === "yil" ? "Fark yıl olarak: son değer eksi önceki." : "Değişim yüzde olarak: son ÷ önceki − 1."}</p>}
    </header>

    {okuma.length > 0 && (
      <section class="okuma" aria-labelledby="ok">
        <h2 id="ok">Veri ne söylüyor</h2>
        <ul>{okuma.map((c) => <li>{c}</li>)}</ul>
        <p class="kucuk">Bu cümleler her güncellemede serinin kendisinden yeniden hesaplanır; yorum değil, konum bilgisidir. <a href="/yontem#okuma">Nasıl hesaplanıyor</a></p>
      </section>
    )}

    {bg?.baglam && (
      <section class="baglam" aria-labelledby="bg">
        <h2 id="bg">Bu gösterge neyi anlatır</h2>
        <p>{bg.baglam}</p>
        {bg.not && <p class="kucuk">Not: {bg.not}</p>}
        {iliskili.length > 0 && (
          <>
            <h3>Birlikte okunacak göstergeler</h3>
            <ul class="iliskili">
              {iliskili.map((x) => { const xs = son(x); return (
                <li>
                  <a href={`/gosterge/${x.id}`}>{x.baslik}</a>
                  <span class="sayi">{deger(x, xs?.deger ?? null)}</span>
                  <span class="kucuk">{xs && donemAdi(xs.donem)} · {x.kaynak.kurum.replace(/\s*\(.*\)$/, "")}</span>
                </li>
              ); })}
            </ul>
            {birlikteAdres && <p><a class="ok" href={birlikteAdres}>Hepsini veri gezgininde birlikte aç →</a></p>}
          </>
        )}
      </section>
    )}

    <SeriGrafik seri={s}>Kaynak: {s.kaynak.kurum}, <a href={kaynakAdresi}>{s.kaynak_kod}</a>. Değerler kaynağın yayımladığı hâliyle.</SeriGrafik>

    {sira && emN && (
      <section class="emsal" aria-labelledby="em">
        <h2 id="em">Emsallerle</h2>
        {sn && tarihselKiyas(sn.donem, sira.donem) && <p><span class="hap hap--uyari">Tarihsel karşılaştırma</span> Emsallerle ortak son dönem {donemAdi(sira.donem)}. Türkiye'nin son verisi {donemAdi(sn.donem)}.</p>}
        <p class="ozet">{siraCumlesi(sira, yaz, ulkeAdi, noktalar(s).at(-1))} Emsal kümesi, Türkiye'yle sık karşılaştırılan yükselen ekonomilerdir{Object.keys(emN).includes("EUU") ? "; Eurostat serilerinde AB üyeleri ve AB-27 toplamı" : ""}. <a href="/yontem#emsal">Neden bu ülkeler</a></p>
        <Serit sira={sira} yaz={yaz} />
        <EmsalGrafik tr={noktalar(s)} ulkeler={emN} birim={s.birim} baslik={s.baslik} />
        <div class="kaydir">
          <table class="sira">
            <caption class="gizli">{donemAdi(sira.donem)} itibarıyla ülkeler, yüksekten düşüğe</caption>
            <thead><tr><th scope="col">Sıra</th><th scope="col">Ülke</th><th scope="col" class="n">{donemAdi(sira.donem)}</th></tr></thead>
            <tbody>
              {sira.satirlar.map((r, i) => <tr class:list={[r.kod === "TUR" && "tr"]}><td class="n">{i + 1}</td><th scope="row">{ulkeAdi(r.kod)}</th><td class="n">{yaz(r.v)}</td></tr>)}
              {sira.toplamlar.map((t) => <tr class="toplam"><td></td><th scope="row">{ulkeAdi(t.kod)} (toplam)</th><td class="n">{yaz(t.v)}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="kucuk">Emsal verisi aynı kaynaktan, aynı seri tanımıyla çekilir{s.izin.api && <>; API: <a href={`/api/v1/emsal/${s.id}.json`}>emsal/{s.id}.json</a></>}.</p>
      </section>
    )}

    <div class="iki">
      <section aria-labelledby="mv">
        <h2 id="mv">Seri bilgisi</h2>
        <dl class="bilgi">
          <div><dt>Kaynağın seri adı</dt><dd>{s.kaynak_adi ?? "—"}</dd></div>
          <div><dt>Birim</dt><dd>{birimAdi(s.birim)}{s.carpan !== 1 && ` × ${s.carpan}`}</dd></div>
          <div><dt>Sıklık</dt><dd>{siklikAdi(s.siklik)}</dd></div>
          <div><dt>Kapsam</dt><dd>{d[0] && donemAdi(d[0].donem)} – {sn && donemAdi(sn.donem)}, {d.length.toLocaleString("tr-TR")} gözlem</dd></div>
          <div><dt>Kaynağın son güncellemesi</dt><dd>{s.kaynak_guncelleme ? tarih(s.kaynak_guncelleme) : "bilinmiyor"}</dd></div>
          <div><dt>Kaynağın seri yayım tarihi</dt><dd>{tarih(sd?.source_release_at ?? null)}</dd></div>
          <div><dt>Son çekim denemesi</dt><dd>{tarih(sd?.son_kontrol ?? null)}{sd?.error_class && ` · ${sd.error_class}`}</dd></div>
          <div><dt>Verinin son değiştiği çekim</dt><dd>{tarih(s.cekildi)}</dd></div>
          <div><dt>Sitede son yayım</dt><dd>{tarih(sd?.site_published_at ?? null)}</dd></div>
          {sd?.estimated_release_at && <div><dt>Tahmini güncellik eşiği</dt><dd>{tarih(sd.estimated_release_at)}</dd></div>}
          {s.kaynak_not && <div><dt>Kaynağın veri notu</dt><dd class="not">{s.kaynak_not}</dd></div>}
        </dl>
      </section>
      <section aria-labelledby="lis">
        <h2 id="lis">Lisans ve indirme</h2>
        <dl class="bilgi">
          <div><dt>Lisans</dt><dd>{s.kaynak.lisans ?? "—"}{s.kaynak.lisans_kanit && <> · <a href={s.kaynak.lisans_kanit}>şart metni</a></>}</dd></div>
          <div><dt>İnceleme</dt><dd>{tarih(s.kaynak.lisans_inceleme)}</dd></div>
          <div><dt>Atıf</dt><dd>{s.kaynak.atif_zorunlu ? `Zorunlu: "${s.kaynak.kurum}, ${s.kaynak_kod}${asil ? "; asıl kaynak: " + asil : ""}"` : "İsteğe bağlı"}</dd></div>
        </dl>
        {(s.kaynak.kosullar ?? []).length > 0 && <ul class="kosul">{s.kaynak.kosullar!.map((k) => <li>{k}</li>)}</ul>}
        {api ? (
          <ul class="indir">
            <li><a href={api}>JSON</a></li>
            {csv && <li><a href={csv} download>CSV</a></li>}
            <li><a href="/api/v1/gozlemler.parquet" download>Parquet (bütün seriler)</a></li>
          </ul>
        ) : (
          <p class="ozet">Bu seri yalnız görüntülenebilir. Kaynağın yeniden dağıtım şartı doğrulanana kadar indirme ve API kapalı.</p>
        )}
      </section>
    </div>

    <section class="revizyon" aria-labelledby="rv">
      <h2 id="rv">Revizyon geçmişi</h2>
      {olaylar.length ? (
        <ul class="olaylar">
          {olaylar.map((o) => (
            <li>
              <time datetime={o.gun}>{tarih(o.gun)}</time>
              <span class:list={["hap", o.tur === "revizyon" ? "hap--uyari" : "hap--bilgi"]}>{o.tur === "revizyon" ? "revizyon" : "yeni dönem"}</span>
              {o.adet ? ` ${o.adet} dönem (${o.ilk}–${o.son})` : o.tur === "revizyon" ? ` ${o.donem}: ${deger(s, o.onceki ?? null)} → ${deger(s, o.yeni ?? null)}` : ` ${o.donem}: ${deger(s, o.yeni ?? null)}`}
            </li>
          ))}
        </ul>
      ) : <p class="ozet">Değişiklik günlüğü başladığından (17 Kasım 2026) beri bu seride yeni dönem ya da düzeltme kaydı yok.</p>}
      <p class="kucuk">Her güncelleme ayrı bir commit'tir; bir gözlemin ilk açıklanan değeri ve her düzeltmesi <a href={gecmis}>dosyanın sürüm geçmişinde</a>. Değer değişmeyen gün dosyaya dokunulmaz.</p>
    </section>

    <section aria-labelledby="tb">
      <h2 id="tb">Gözlemler</h2>
      {gunluk && <p class="kucuk">Son 90 iş günü gösteriliyor; {d.length.toLocaleString("tr-TR")} gözlemin tamamı {csv ? <a href={csv}>CSV</a> : "kaynakta"}.</p>}
      {!gunluk && <p class="kucuk">{tablo.length.toLocaleString("tr-TR")} dönem, yeniden eskiye; tablo kendi içinde kayar.{csv && <> Tamamı: <a href={csv}>CSV</a>.</>}</p>}
      <div class="kaydir tablo-kutu gozlem-kutu" tabindex="0" role="region" aria-label={`${s.baslik}, gözlem tablosu`}>
        <table>
          <caption class="gizli">{s.baslik}, gözlemler, yeniden eskiye</caption>
          <thead><tr><th scope="col">Dönem</th><th scope="col" class="n">Değer</th>{yillik.size > 0 && <th scope="col" class="n">Bir yıl önceye göre</th>}<th scope="col" class="n">Kaynaktaki ham değer</th></tr></thead>
          <tbody>
            {tablo.map((g) => (
              <tr><th scope="row">{g.donem}{gozlemEtiketi(s, g) && <small class="bayrak"> · {gozlemEtiketi(s, g)}</small>}</th><td class="n cubuklu" style={cubuk(g.deger)} data-eksi={g.deger != null && Number(g.deger) < 0 ? "" : undefined}>{deger(s, g.deger)}</td>{yillik.size > 0 && <td class="n">{yillik.has(g.donem) ? <span class="yon" data-yon={Math.sign(Number(yillik.get(g.donem)!.fark.toFixed(1)))}>{yfYaz(yillik.get(g.donem)!)}</span> : "—"}</td>}<td class="n ham">{g.deger ?? "yayımlanmadı"}{g.durum && g.durum !== "A" && <span class="bayrak" title="Kaynağın gözlem bayrağı"> {g.durum}</span>}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </article>
</Taban>
<style>
  .iz { padding-top: 1.5rem; font-size: .85rem; color: var(--soluk); }
  /* 306 satırlık tablo sayfanın %78'ini tutuyordu (24 Kasım 2026): kutu içinde kayar, başlık sabit. */
  .gozlem-kutu { max-height: min(70vh, 34rem); max-width: 54rem; }
  #tb { padding-top: 1.5rem; }
  .bas { display: grid; gap: .6rem; padding-block: 1rem 0; }
  .guncellik { display: flex; flex-wrap: wrap; gap: .3rem 1rem; align-items: center; margin: 0; font-size: .82rem; color: var(--soluk); }
  .eylem { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; margin: 0; font-weight: 600; font-size: .92rem; }
  .revizyon { display: grid; gap: .6rem; padding-top: 2rem; }
  .baglam { display: grid; gap: .6rem; padding-block: 1.5rem; max-width: 72ch; }
  .baglam p { margin: 0; }
  .baglam h3 { font-size: 1rem; margin-top: .4rem; }
  .iliskili { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--cizgi); }
  .iliskili li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .1rem 1rem; padding: .55rem 0; border-bottom: 1px solid var(--cizgi); }
  .iliskili a { font-weight: 600; text-decoration: none; }
  .iliskili a:hover { text-decoration: underline; }
  .iliskili .sayi { font-weight: 650; text-align: right; }
  .iliskili .kucuk { grid-column: 1 / -1; color: var(--soluk); font-size: .8rem; }
  .ok { font-weight: 600; }
  .olaylar { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; font-size: .9rem; }
  .olaylar time { color: var(--soluk); font-size: .82rem; margin-right: .5rem; }
  .olaylar .hap { margin-right: .3rem; }
  .buyuk { margin: .4rem 0 0; font-size: clamp(2.2rem, 1.6rem + 3vw, 3.4rem); font-weight: 750; letter-spacing: -.02em; line-height: 1; }
  .buyuk span { font-size: 1rem; font-weight: 500; color: var(--soluk); letter-spacing: 0; }
  .okuma { margin-top: 1.5rem; padding: 1rem 1.2rem; border-left: 3px solid var(--dv-1); background: var(--yuzey); }
  .okuma h2 { font-size: .75rem; font: 600 .7rem/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soluk); margin-bottom: .6rem; }
  .okuma ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .35rem; max-width: 70ch; }
  .okuma li { font-size: 1.02rem; }
  .kucuk { font-size: .8rem; color: var(--soluk); margin: .6rem 0 0; }
  .emsal { margin: 2rem 0; display: grid; gap: .5rem; }
  .emsal .ozet { margin: 0 0 .5rem; }
  .sira { max-width: 30rem; }
  .sira tr.tr th, .sira tr.tr td { font-weight: 700; color: var(--dv-1); }
  .sira tr.toplam th, .sira tr.toplam td { color: var(--soluk); font-style: italic; }
  .iki { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); margin: 1rem 0 2rem; }
  h2 { font-size: 1.15rem; margin: 0 0 .75rem; }
  .bilgi { margin: 0; border-top: 1px solid var(--metin); }
  .bilgi div { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--cizgi); font-size: .9rem; }
  .bilgi dt { color: var(--soluk); }
  .bilgi dd { margin: 0; overflow-wrap: anywhere; }
  .not { font-size: .82rem; color: var(--soluk); }
  .indir { display: flex; gap: .5rem; flex-wrap: wrap; list-style: none; padding: 0; margin: 1rem 0 0; }
