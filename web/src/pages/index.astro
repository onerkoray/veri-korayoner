---
import Taban from "../layouts/Taban.astro";
import Kivilcim from "../components/Kivilcim.astro";
import KpiKart from "../components/KpiKart.astro";
import AnaGrafik from "../components/AnaGrafik.astro";
import Serit from "../components/Serit.astro";
import { seriler, kaynaklar, uretildi, TEMA, TEMA_SIRA, deger, degisim, son, onceki, tarih, siklikAdi, ulkeAdi, degisiklikler, durum } from "../lib/veri";
import { donemAdi, zaman, ek } from "../lib/okuma.ts";
import { reelPaket, isaretSuresi, emsalSatirlari } from "../lib/turetilmis";
import { KISI } from "../lib/kimlik";

const ss = seriler();
const ks = kaynaklar();
const aktif = ks.filter((k) => ss.some((s) => s.kaynak.id === k.id));   // en az bir serisi yayında olan kurumlar
const gruplar = TEMA_SIRA.map((t) => ({ t, ad: TEMA[t], liste: ss.filter((s) => s.tema === t) })).filter((g) => g.liste.length);
const gozlemSayisi = ss.reduce((a, s) => a + s.gozlemler.filter((g) => g.deger != null).length, 0);
const kisaKurum = (k: string) => k.replace(/\s*\(.*\)$/, "").replace("Uluslararası Ödemeler Bankası", "BIS").replace("Avrupa Birliği İstatistik Ofisi", "Eurostat").replace("Uluslararası Çalışma Örgütü", "ILO");
const kaynakListesi = new Intl.ListFormat("tr", { type: "conjunction" }).format(aktif.map((k) => kisaKurum(k.kurum)));
const saglik = durum();
const durumOf = (id: string) => saglik?.seriler.find((r) => r.id === id);

// Manşet: bu sitenin hesabı
const reel = reelPaket();
const reelIsaret = reel ? isaretSuresi(reel.r) : null;

// Türkiye nerede: emsali olan her gösterge bir şerit
const satirlar = emsalSatirlari();

// Panorama KPI'ları: her biri yayımlanmış bir seriden (reel faiz bu sitenin hesabı, işaretli).
const KPI: [string, string][] = [["bis-tufe-yillik-tr", "Yıllık enflasyon (TÜFE)"], ["bis-politika-faizi-tr", "Politika faizi"],
  ["wb-ny-gdp-mktp-kd-zg-tur", "Ekonomik büyüme (yıllık, reel)"], ["eurostat-issizlik-aylik-tr", "İşsizlik oranı (mevsimsellikten arındırılmış)"],
  ["wb-bn-cab-xoka-gd-zs-tur", "Cari işlemler dengesi"]];
const kpiler = KPI.map(([id, ad]) => ({ s: ss.find((x) => x.id === id), ad })).filter((x): x is { s: (typeof ss)[number]; ad: string } => !!x.s);

// Son açıklanan veriler: her serinin son dönemi, en yeniden; değişiklik günlüğündeki son olayıyla.
const sonOlay = (id: string) => degisiklikler().find((o) => o.seri === id);
const sonVeriler = ss.map((s) => ({ s, sn: son(s)!, on: onceki(s), dg: degisim(s), olay: sonOlay(s.id) })).filter((x) => x.sn)
  .sort((a, b) => zaman(b.sn.donem) - zaman(a.sn.donem) || a.s.baslik.localeCompare(b.s.baslik, "tr")).slice(0, 10);
const baslikOf = (id: string) => ss.find((s) => s.id === id);
const olaylar = degisiklikler().slice(0, 12);
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://veri.korayoner.dev/#site", url: "https://veri.korayoner.dev/", name: "Türkiye Verisi",
      description: "Uluslararası kurumların Türkiye serileri, emsal ülke karşılaştırması ve açık API.", inLanguage: "tr",
      author: { "@id": KISI["@id"] }, publisher: { "@id": KISI["@id"] } },
    KISI,
  ],
};
---
<Taban baslik="Türkiye Verisi — uluslararası kurumların Türkiye serileri ve emsal karşılaştırması" aciklama="BIS, Dünya Bankası, OECD, Eurostat ve ILO'nun Türkiye verileri: emsal ülkelerle sıralama, reel faiz hesabı, revizyon kaydı, lisansıyla açık API." yol="/" jsonld={jsonld}>
  <section class="sar giris">
    <p class="etiket">Türkiye · uluslararası kaynaklar</p>
    <h1>Türkiye ekonomisinin görünümü</h1>
    <p class="ozet">Temel göstergeler, kaynağından: {kaynakListesi}. Seriler her iş günü sabah asıl kaynağından çekilir; her gösterge emsal ekonomilerin aynı serisiyle yan yana durur. Kartlardaki dönem kaynağın açıkladığı dönemdir, çekim günü değil.</p>
    <p class="gezgin-cta"><a href="/gezgin">Veri gezginini açın →</a> <span>Göstergeleri seçin; aylık, çeyreklik ya da yıllık karşılaştırın, yıl×ay tablosunda görün, CSV indirin.</span></p>
    <dl class="durum">
      <div><dt>Gösterge</dt><dd class="sayi">{ss.length}</dd></div>
      <div><dt>Gözlem</dt><dd class="sayi">{gozlemSayisi.toLocaleString("tr-TR")}</dd></div>
      <div><dt>Kaynak</dt><dd class="sayi">{aktif.length} kurum</dd></div>
      <div><dt>Son kontrol</dt><dd>{tarih(saglik?.son_kontrol ?? uretildi())}</dd></div>
      {saglik && (
        <div><dt>Veri sağlığı</dt><dd><a href="/kaynaklar" class="saglik">{saglik.ozet.yayinda}/{saglik.ozet.seri} yayında</a>
          {(saglik.ozet.hatali > 0 || saglik.ozet.geciken > 0) && (
            <span class="saglik-not">{[saglik.ozet.hatali && `${saglik.ozet.hatali} seride son çekim başarısız (önceki veri gösteriliyor)`, saglik.ozet.geciken && `${saglik.ozet.geciken} seri gecikmiş`].filter(Boolean).join(" · ")}</span>
          )}</dd></div>
      )}
    </dl>
  </section>

  <section class="sar kpiler" aria-labelledby="k-baslik">
    <h2 id="k-baslik" class="gizli">Temel göstergeler</h2>
    <ul class="kpi-izgara">
      {kpiler.map(({ s, ad }) => <KpiKart seri={s} ad={ad} href={`/gosterge/${s.id}`} kaynak={kisaKurum(s.kaynak.kurum)} durum={durumOf(s.id)} />)}
      {reel && reelIsaret && <KpiKart seri={reel.seri} ad="Reel politika faizi (ex post)" href="/hesap/reel-politika-faizi" kaynak="BIS verisiyle" hesap
        not={`${reelIsaret.ay} aydır ${reelIsaret.isaret > 0 ? "pozitif" : "negatif"}; gerçekleşen enflasyona göre.`} />}
    </ul>
  </section>

  {reel && <AnaGrafik faiz={reel.faiz} enf={reel.enf} reel={reel.r} />}

  {satirlar.length > 0 && (
    <section class="sar nerede" aria-labelledby="n-baslik">
      <h2 id="n-baslik">Türkiye nerede?</h2>
      <p class="ozet">Her satırda bir gösterge; noktalar emsal ülkeler, mavi nokta Türkiye, dikey çizgi emsal medyanı. Ülke adı ve değer için noktanın üzerine gelin. Emsal kümesi: {["BRA", "MEX", "ZAF", "POL", "HUN", "IND", "IDN", "CHL", "COL"].map(ulkeAdi).join(", ")}; Eurostat satırlarında AB üyeleri ve AB-27.</p>
      <ul class="satirlar">
        {satirlar.map((r) => (
          <li>
            <div class="satir-bas">
              <a href={r.href}>{r.baslik}</a>
              <span class="satir-yer">{donemAdi(r.sira.donem)} · {r.sira.sira === 1 ? "en yüksek" : r.sira.sira === r.sira.toplam ? "en düşük" : `${r.sira.toplam} ülke içinde ${r.sira.sira}.`}{r.trSon !== r.sira.donem && ` (Türkiye'nin son verisi ${donemAdi(r.trSon)})`} · {r.kaynak}</span>
            </div>
            <Serit sira={r.sira} yaz={r.yaz} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="sar hareket" aria-labelledby="h-baslik">
    <h2 id="h-baslik">Son açıklanan veriler</h2>
    <div class="kaydir">
      <table>
        <thead><tr><th scope="col">Dönem</th><th scope="col">Gösterge</th><th scope="col" class="n">Değer</th><th scope="col" class="n">Önceki</th><th scope="col" class="n">Değişim</th><th scope="col">Güncelleme</th><th scope="col">Kaynak</th></tr></thead>
        <tbody>
          {sonVeriler.map(({ s, sn, on, dg, olay }) => (
            <tr>
              <td class="donem-h">{donemAdi(sn.donem)}</td>
              <th scope="row"><a href={`/gosterge/${s.id}`}>{s.baslik}</a></th>
              <td class="n sayi">{deger(s, sn.deger)}</td>
              <td class="n sayi soluk-h">{on ? <>{deger(s, on.deger)}<small> {donemAdi(on.donem)}</small></> : "—"}</td>
              <td class="n sayi">{dg?.metin ?? "—"}</td>
              <td class="tur-h">{olay ? <span class:list={["hap", olay.tur === "revizyon" ? "hap--uyari" : "hap--bilgi"]} title={`Değişiklik günlüğü, ${tarih(olay.gun)}`}>{olay.tur === "revizyon" ? "revizyon" : "yeni dönem"}</span> : <span class="soluk-h" title="Değişiklik günlüğü 17 Kasım 2026'da başladı">—</span>}</td>
              <td class="kaynak-h">{kisaKurum(s.kaynak.kurum)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {olaylar.length > 0 && (
      <>
        <h3>Kaynakların düzeltmeleri ve yeni dönemleri</h3>
        <ul class="olaylar">
          {olaylar.map((o) => {
            const s = baslikOf(o.seri);
            if (!s) return null;
            const yz = (v?: string | null) => deger(s, v ?? null);
            return (
              <li>
                <time datetime={o.gun}>{tarih(o.gun)}</time>
                <a href={`/gosterge/${s.id}`}>{s.baslik}</a>:
                {o.tur === "revizyon"
                  ? (o.adet ? ` ${o.adet} dönem revize edildi (${o.ilk}–${o.son}).` : ` ${o.donem} değeri ${yz(o.onceki)} → ${yz(o.yeni)} revize edildi.`)
                  : (o.adet ? ` ${o.adet} yeni dönem eklendi (${o.ilk}–${o.son}).` : ` ${o.donem} açıklandı: ${yz(o.yeni)}.`)}
              </li>
            );
          })}
        </ul>
      </>
    )}
    <p class="kucuk">Revizyon kaydı 17 Kasım 2026'da başladı; daha eski düzeltmeler deponun commit geçmişinde. API: <a href="/api/v1/degisiklikler.json">degisiklikler.json</a></p>
  </section>

  {gruplar.map((g) => (
    <section class="sar tema" aria-labelledby={`t-${g.t}`}>
      <h2 id={`t-${g.t}`}>{g.ad}</h2>
      <ul class="kartlar">
        {g.liste.map((s) => {
          const sn = son(s), dg = degisim(s);
          return (
            <li class="kart">
              <a href={`/gosterge/${s.id}`} class="kart-bag">
                <p class="kart-baslik">{s.baslik}</p>
                <p class="kart-deger sayi">{deger(s, sn?.deger ?? null)}</p>
                <p class="kart-alt">
                  <span>{sn && donemAdi(sn.donem)}</span>
                  {dg && <span class="deg">{dg.metin}</span>}
                </p>
                <Kivilcim seri={s} n={s.siklik === "gunluk" ? 250 : s.siklik === "aylik" ? 36 : 20} />
                <p class="kart-kaynak">{s.kaynak.kurum.replace(/\s*\(.*\)$/, "")} · {siklikAdi(s.siklik)}{!s.izin.api && " · yalnız gösterim"}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <section class="sar tema">
    <h2>Sırada</h2>
    <p class="ozet">Lisansı ve erişimi doğrulandıkça eklenecek kaynaklar. Planlanan bir kaynak, kullanım şartı okunup kanıt adresi kayda geçmeden yayımlanmaz. <a href="/kaynaklar">Bütün kaynaklar ve durumları</a></p>
    <ul class="sirada">{ks.filter((k) => !k.yayin.gosterim).map((k) => <li>{k.kurum}</li>)}</ul>
  </section>
</Taban>
<style>
  .giris { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; display: grid; gap: 1rem; }
  .gezgin-cta { margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: baseline; }
  .gezgin-cta a { display: inline-block; background: var(--metin); color: var(--bg); padding: .65rem 1rem; font-weight: 650; text-decoration: none; }
  .gezgin-cta a:hover { background: var(--vurgu); color: var(--bg); }
  .gezgin-cta span { color: var(--soluk); font-size: .9rem; }
  .durum { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0 1.5rem; margin: .5rem 0 0; border-top: 1px solid var(--metin); }
  .durum div { padding: .8rem 0; border-bottom: 1px solid var(--cizgi); }
  .durum dt { font: 600 .68rem/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--soluk); }
  .durum dd { margin: .25rem 0 0; font-size: 1.3rem; font-weight: 650; }
  .saglik { font-weight: 650; }
  .saglik-not { display: block; font-size: .78rem; font-weight: 400; color: var(--soluk); line-height: 1.35; margin-top: .2rem; }
  .kpiler { padding-block: 1.5rem 0; }
  .kpi-izgara { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 36rem) { .kpi-izgara { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .kpi-izgara { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .soluk-h { color: var(--soluk); }
  .soluk-h small { display: block; font-size: .72rem; }
  .tur-h { white-space: nowrap; }
  .nerede { padding-block: 2rem 0; }
  .nerede .ozet { margin: .5rem 0 1rem; }
  .satirlar { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--metin); }
  .satirlar li { padding: .9rem 0 .2rem; border-bottom: 1px solid var(--cizgi); }
  .satir-bas { display: flex; justify-content: space-between; gap: .3rem 1rem; flex-wrap: wrap; align-items: baseline; }
  .satir-bas a { font-weight: 650; text-decoration: none; }
  .satir-bas a:hover { text-decoration: underline; }
  .satir-yer { font-size: .8rem; color: var(--soluk); }
  .hareket { padding-block: 2.5rem 0; display: grid; gap: .75rem; }
  .hareket h3 { font-size: 1rem; margin-top: 1rem; }
  .hareket th a { text-decoration: none; font-weight: 600; }
  .donem-h, .kaynak-h { white-space: nowrap; color: var(--soluk); font-size: .85rem; }
  .olaylar { margin: 0; padding-left: 1.1rem; display: grid; gap: .3rem; font-size: .92rem; }
  .olaylar time { color: var(--soluk); font-size: .82rem; margin-right: .4rem; }
  .kucuk { font-size: .8rem; color: var(--soluk); margin: 0; }
  .tema { padding-block: 2.5rem 0; }
  .tema h2 { margin-bottom: 1rem; }
  .kartlar { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr)); }
  .kart { background: var(--yuzey); border: 1px solid var(--cizgi); }
  .kart-bag { display: grid; gap: .35rem; padding: 1rem 1.1rem 1.1rem; text-decoration: none; height: 100%; }
  .kart-bag:hover { background: var(--yuzey-2); color: inherit; }
  .kart-baslik { margin: 0; font-size: .9rem; color: var(--soluk); min-height: 2.6em; }
  .kart-deger { margin: 0; font-size: 1.65rem; font-weight: 700; letter-spacing: -.01em; }
  .kart-alt { margin: 0; display: flex; gap: .7rem; font-size: .82rem; color: var(--soluk); }
  .kart-kaynak { margin: .2rem 0 0; font: .68rem/1.4 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--soluk); }
  .sirada { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  .sirada li { border: 1px dashed var(--cizgi); padding: .3rem .6rem; font-size: .85rem; color: var(--soluk); }
</style>
