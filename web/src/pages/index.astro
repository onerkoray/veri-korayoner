---
import Taban from "../layouts/Taban.astro";
import VeriAkisi from "../components/VeriAkisi.astro";
import Kivilcim from "../components/Kivilcim.astro";
import KpiKart from "../components/KpiKart.astro";
import AnaGrafik from "../components/AnaGrafik.astro";
import Serit from "../components/Serit.astro";
import { seriler, degerTuru, kaynaklar, uretildi, TEMA, TEMA_SIRA, deger, degisim, son, onceki, tarih, siklikAdi, ulkeAdi, degisiklikler, durum } from "../lib/veri";
import { donemAdi, zaman, ek } from "../lib/okuma.ts";
import { reelPaket, isaretSuresi, emsalSatirlari } from "../lib/turetilmis";
import { KISI } from "../lib/kimlik";

const ss = seriler();
const ks = kaynaklar();
const aktif = ks.filter((k) => ss.some((s) => s.kaynak.id === k.id));   // en az bir serisi yayında olan kurumlar
const gruplar = TEMA_SIRA.map((t) => ({ t, ad: TEMA[t], liste: ss.filter((s) => s.tema === t) })).filter((g) => g.liste.length);
const gozlemSayisi = ss.reduce((a, s) => a + s.gozlemler.filter((g) => g.deger != null).length, 0);
const kisaKurum = (k: string) => k.replace(/\s*\(.*\)$/, "").replace("Uluslararası Ödemeler Bankası", "BIS").replace("Avrupa Birliği İstatistik Ofisi", "Eurostat").replace("Uluslararası Çalışma Örgütü", "ILO");
const kaynakListesi = new Intl.ListFormat("tr", { type: "conjunction" }).format(aktif.map((k) => kisaKurum(k.kurum)));
const saglik = durum();
const durumOf = (id: string) => saglik?.seriler.find((r) => r.id === id);

// Manşet: bu sitenin hesabı
const reel = reelPaket();
const reelIsaret = reel ? isaretSuresi(reel.r) : null;

// Türkiye nerede: emsali olan her gösterge bir şerit. Ortak dönem Türkiye'nin son verisinden
// TARIHSEL_YIL yıldan eskiyse (ör. 2024 verisine karşı 1998 sıralaması) satır bugünkü konum gibi
// okunmasın diye burada gösterilmez; gösterge sayfasında "tarihsel karşılaştırma" etiketiyle durur (D-07).
const TARIHSEL_YIL = 5;
const yilFarki = (r: { trSon: string; sira: { donem: string } }) => Number(r.trSon.slice(0, 4)) - Number(r.sira.donem.slice(0, 4));
const tumSatirlar = emsalSatirlari();
const guncelSatirlar = tumSatirlar.filter((r) => yilFarki(r) <= TARIHSEL_YIL);
// Panorama özet: KPI'lardaki göstergeler ve reel faiz. 50 şeridin hepsi Karşılaştır'da durur;
// burada hepsini dizmek sayfanın %39'unu tutuyordu (24 Kasım 2026 ölçümü: 5.800 / 15.000 px).
const MANSET = new Set(["/hesap/reel-politika-faizi", "/gosterge/bis-politika-faizi-tr", "/gosterge/bis-tufe-yillik-tr",
  "/gosterge/wb-ny-gdp-mktp-kd-zg-tur", "/gosterge/eurostat-issizlik-aylik-tr", "/gosterge/wb-bn-cab-xoka-gd-zs-tur"]);
const satirlar = guncelSatirlar.filter((r) => MANSET.has(r.href));

// Panorama KPI'ları: her biri yayımlanmış bir seriden (reel faiz bu sitenin hesabı, işaretli).
const KPI: [string, string][] = [["bis-tufe-yillik-tr", "Yıllık enflasyon (TÜFE)"], ["bis-politika-faizi-tr", "Politika faizi"],
  ["wb-ny-gdp-mktp-kd-zg-tur", "Ekonomik büyüme (yıllık, reel)"], ["eurostat-issizlik-aylik-tr", "İşsizlik oranı (mevsimsellikten arındırılmış)"],
  ["wb-bn-cab-xoka-gd-zs-tur", "Cari işlemler dengesi"]];
const kpiler = KPI.map(([id, ad]) => ({ s: ss.find((x) => x.id === id), ad })).filter((x): x is { s: (typeof ss)[number]; ad: string } => !!x.s);

// Son açıklanan veriler: her serinin son dönemi, en yeniden; değişiklik günlüğündeki son olayıyla.
const sonOlay = (id: string) => degisiklikler().find((o) => o.seri === id);
const sonVeriler = ss.map((s) => ({ s, sn: son(s)!, on: onceki(s), dg: degisim(s), olay: sonOlay(s.id) })).filter((x) => x.sn)
  .sort((a, b) => zaman(b.sn.donem) - zaman(a.sn.donem) || a.s.baslik.localeCompare(b.s.baslik, "tr")).slice(0, 10);
const baslikOf = (id: string) => ss.find((s) => s.id === id);
const olaylar = degisiklikler().slice(0, 12);
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://veri.korayoner.dev/#site", url: "https://veri.korayoner.dev/", name: "Türkiye Verisi",
      description: "Uluslararası kurumların Türkiye serileri, emsal ülke karşılaştırması ve açık API.", inLanguage: "tr",
      author: { "@id": KISI["@id"] }, publisher: { "@id": KISI["@id"] } },
    KISI,
  ],
};
---
<Taban baslik="Türkiye Verisi — uluslararası kurumların Türkiye serileri ve emsal karşılaştırması" aciklama="BIS, Dünya Bankası, OECD, Eurostat ve ILO'nun Türkiye verileri: emsal ülkelerle sıralama, reel faiz hesabı, revizyon kaydı, lisansıyla açık API." yol="/" jsonld={jsonld}>
  <section class="sar giris" aria-labelledby="p-baslik">
    <div class="giris-izgara">
      <div class="giris-metin">
        <p class="etiket panorama-etiket">Türkiye Verisi / Panorama</p>
        <h1 id="p-baslik">Türkiye Ekonomik Görünümü</h1>
        <p class="ozet">Türkiye'nin temel göstergelerini uluslararası kaynaklardan izleyin. Serilerin zaman içindeki seyrini görün, emsal ülkelerle karşılaştırın.</p>
        <div class="gezgin-cta">
          <a href="/gezgin">Veri gezginini açın <span aria-hidden="true">↗</span></a>
          <a href="#gostergeler">Bütün göstergeler <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <aside class="kapsam" aria-labelledby="kapsam-baslik">
        <div class="kapsam-ust">
          <h2 id="kapsam-baslik">Veri kapsamı</h2>
          <a href="/kaynaklar">Kaynaklar <span aria-hidden="true">↗</span></a>
        </div>
        <dl class="durum">
          <div><dt>Gösterge</dt><dd class="sayi">{ss.length}</dd></div>
          <div><dt>Gözlem</dt><dd class="sayi">{gozlemSayisi.toLocaleString("tr-TR")}</dd></div>
          <div><dt>Kurum</dt><dd class="sayi">{aktif.length}</dd></div>
        </dl>
        <p class="kapsam-kurum">{kaynakListesi}</p>
        <p class="kapsam-kontrol"><span>Son kontrol</span><strong>{tarih(saglik?.son_kontrol ?? uretildi())}</strong></p>
        {saglik && (saglik.ozet.hatali > 0 || saglik.ozet.geciken > 0) && (
          <p class="saglik-not">{[saglik.ozet.hatali && `${saglik.ozet.hatali} seride son çekim başarısız (önceki veri gösteriliyor)`, saglik.ozet.geciken && `${saglik.ozet.geciken} seri gecikmiş`].filter(Boolean).join(" · ")}</p>
        )}
      </aside>
    </div>
  </section>

  <section class="sar kpiler" aria-labelledby="k-baslik">
    <div class="bolum-baslik">
      <h2 id="k-baslik">Temel göstergeler</h2>
      <p class="ozet">Kartlarda verinin ait olduğu dönem gösterilir.</p>
    </div>
    <ul class="kpi-izgara">
      {kpiler.map(({ s, ad }) => <KpiKart seri={s} ad={ad} href={`/gosterge/${s.id}`} kaynak={kisaKurum(s.kaynak.kurum)} durum={durumOf(s.id)} />)}
      {reel && reelIsaret && <KpiKart seri={reel.seri} ad="Reel politika faizi (ex post)" href="/hesap/reel-politika-faizi" kaynak="BIS verisiyle" hesap
        not={`${reelIsaret.ay} aydır ${reelIsaret.isaret > 0 ? "pozitif" : "negatif"}; gerçekleşen enflasyona göre.`} />}
    </ul>
  </section>

  {reel && <AnaGrafik faiz={reel.faiz} enf={reel.enf} reel={reel.r} />}

  {satirlar.length > 0 && (
    <section class="sar nerede" aria-labelledby="n-baslik">
      <h2 id="n-baslik">Türkiye nerede?</h2>
      <p class="ozet">Temel göstergelerde Türkiye'nin emsal ekonomiler arasındaki yeri: noktalar emsal ülkeler, mavi nokta Türkiye, dikey çizgi emsal medyanı. Ülke adı ve değer için noktanın üzerine gelin.</p>
      <ul class="satirlar">
        {satirlar.map((r) => (
          <li>
            <div class="satir-bas">
              <a href={r.href}>{r.baslik}</a>
              <span class="satir-yer">{yilFarki(r) > 2 && "Tarihsel karşılaştırma · "}{donemAdi(r.sira.donem)} · {r.sira.sira === 1 ? "en yüksek" : r.sira.sira === r.sira.toplam ? "en düşük" : `${r.sira.toplam} ülke içinde ${r.sira.sira}.`}{r.trSon !== r.sira.donem && ` (Türkiye'nin son verisi ${donemAdi(r.trSon)})`} · {r.kaynak}</span>
            </div>
            <Serit sira={r.sira} yaz={r.yaz} />
          </li>
        ))}
      </ul>
      <p class="devam"><a href="/karsilastir#k-son">Bütün {tumSatirlar.length} göstergede Türkiye'nin sırası →</a> <span>Emsal kümesi: {["BRA", "MEX", "ZAF", "POL", "HUN", "IND", "IDN", "CHL", "COL"].map(ulkeAdi).join(", ")}; Eurostat'ta AB üyeleri.</span></p>
    </section>
  )}

  <section class="sar hareket" aria-labelledby="h-baslik">
    <h2 id="h-baslik">Son açıklanan veriler</h2>
    <div class="kaydir veri-akis-tablosu" role="region" aria-labelledby="h-baslik" tabindex="0">
      <table>
        <thead><tr><th scope="col">Dönem</th><th scope="col">Gösterge</th><th scope="col" class="n">Değer</th><th scope="col" class="n">Önceki</th><th scope="col" class="n">Değişim</th><th scope="col">Seyir</th><th scope="col">Güncelleme</th><th scope="col">Kaynak</th></tr></thead>
        <tbody>
          {sonVeriler.map(({ s, sn, on, dg, olay }) => (
            <tr>
              <td class="donem-h">{donemAdi(sn.donem)}</td>
              <th scope="row"><a href={`/gosterge/${s.id}`}>{s.baslik}</a></th>
              <td class="n sayi">{deger(s, sn.deger)}</td>
              <td class="n sayi soluk-h">{on ? <>{deger(s, on.deger)}<small> {donemAdi(on.donem)}</small></> : "—"}</td>
              <td class="n sayi">{dg ? <span class="yon" data-yon={dg.yon}>{dg.metin}</span> : "—"}</td>
              <td class="seyir"><Kivilcim seri={s} n={12} kucuk /></td>
              <td class="tur-h">{olay ? <span class:list={["hap", olay.tur === "revizyon" ? "hap--uyari" : "hap--bilgi"]} title={`Değişiklik günlüğü, ${tarih(olay.gun)}`}>{olay.tur === "revizyon" ? "revizyon" : "yeni dönem"}</span> : <span class="soluk-h" title="Değişiklik günlüğü 17 Kasım 2026'da başladı">—</span>}</td>
              <td class="kaynak-h">{kisaKurum(s.kaynak.kurum)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {olaylar.length > 0 && (
      <>
        <details class="olay-kutu">
        <summary>Kaynakların düzeltmeleri ve yeni dönemleri ({olaylar.length})</summary>
        <ul class="olaylar">
          {olaylar.map((o) => {
            const s = baslikOf(o.seri);
            if (!s) return null;
            const yz = (v?: string | null) => deger(s, v ?? null);
            return (
              <li>
                <time datetime={o.gun}>{tarih(o.gun)}</time>
                <a href={`/gosterge/${s.id}`}>{s.baslik}</a>:
                {o.tur === "revizyon"
                  ? (o.adet ? ` ${o.adet} dönem revize edildi (${o.ilk}–${o.son}).` : ` ${o.donem} değeri ${yz(o.onceki)} → ${yz(o.yeni)} revize edildi.`)
                  : (o.adet ? ` ${o.adet} yeni dönem eklendi (${o.ilk}–${o.son}).` : ` ${o.donem} açıklandı: ${yz(o.yeni)}.`)}
              </li>
            );
          })}
        </ul>
        </details>
      </>
    )}
    <p class="kucuk">Revizyon kaydı 17 Kasım 2026'da başladı; daha eski düzeltmeler deponun commit geçmişinde. API: <a href="/api/v1/degisiklikler.json">degisiklikler.json</a></p>
  </section>

  <section class="sar temalar" id="gostergeler" aria-labelledby="tm-baslik">
    <div class="katalog-ust">
      <div>
        <h2 id="tm-baslik">Bütün göstergeler</h2>
        <p class="ozet">{gruplar.length} tema, {ss.length} gösterge. Bir gösterge seçerek serinin ayrıntılarını açın.</p>
      </div>
      <div class="p-arama" hidden>
        <label for="panorama-ara">Gösterge, seri kodu veya kurum ara</label>
        <div class="arama-kutu">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.25"/><path d="m12.4 12.4 4.1 4.1"/></svg>
          <input id="panorama-ara" type="search" autocomplete="off" placeholder="Örn. enflasyon, NY.GDP, OECD" />
        </div>
        <span id="p-sonuc" role="status"></span>
      </div>
    </div>
    <div class="tema-sekme" role="tablist" aria-label="Tema" hidden>
      {gruplar.map((g, i) => <button type="button" role="tab" id={`ts-${g.t}`} aria-controls={`tp-${g.t}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>{g.ad} <span>{g.liste.length}</span></button>)}
    </div>
  {gruplar.map((g) => (
    <section class="tema" id={`tp-${g.t}`} aria-labelledby={`t-${g.t}`}>
      <h3 id={`t-${g.t}`}>{g.ad}</h3>
      <ul class="kartlar">
        {g.liste.map((s) => {
          const sn = son(s), dg = degisim(s);
          return (
            <li class="kart" data-ara={`${s.baslik} ${s.id} ${s.kaynak_kod} ${s.kaynak.kurum} ${g.ad}`}>
              <a href={`/gosterge/${s.id}`} class="kart-bag">
                <p class="kart-baslik">{s.baslik}</p>
                <p class="kart-deger sayi">{deger(s, sn?.deger ?? null)}</p>
                <p class="kart-alt">
                  <span>{sn && donemAdi(sn.donem)}</span>
                  {dg && <span class="deg">{dg.metin}</span>}
                </p>
                <Kivilcim seri={s} n={s.siklik === "gunluk" ? 250 : s.siklik === "aylik" ? 36 : 20} />
                <p class="kart-kaynak">{s.kaynak.kurum.replace(/\s*\(.*\)$/, "")} · {siklikAdi(s.siklik)}{!s.izin.api && " · yalnız gösterim"}{degerTuru(s) && ` · ${degerTuru(s)!.toLocaleLowerCase("tr")}`}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
  </section>

  <section class="sar akis-bolum" aria-labelledby="akis-h">
    <h2 id="akis-h">Veri nasıl geliyor</h2>
    <VeriAkisi kisa etiket={false} />
  </section>

  <section class="sar sirada-bolum">
    <h2>Sırada</h2>
    <p class="ozet">Lisansı ve erişimi doğrulandıkça eklenecek kaynaklar. Planlanan bir kaynak, kullanım şartı okunup kanıt adresi kayda geçmeden yayımlanmaz. <a href="/kaynaklar">Bütün kaynaklar ve durumları</a></p>
    <ul class="sirada">{ks.filter((k) => !k.yayin.gosterim).map((k) => <li>{k.kurum}</li>)}</ul>
  </section>
  <script>
    import { eslesir } from "../lib/gezgin-cekirdek";
    // Tema sekmeleri: JS yoksa bütün temalar alt alta açık kalır.
    const sekme = document.querySelector<HTMLElement>(".tema-sekme")!;
    const dugmeler = [...sekme.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const paneller = [...document.querySelectorAll<HTMLElement>("section.tema")];
    let etkin = 0;
    const sec = (i: number, odak = false) => {
      etkin = i;
      dugmeler.forEach((d, j) => { d.setAttribute("aria-selected", String(j === i)); d.tabIndex = j === i ? 0 : -1; });
      paneller.forEach((p, j) => { p.hidden = j !== i; p.setAttribute("role", "tabpanel"); p.setAttribute("aria-labelledby", dugmeler[j].id); });
      if (odak) dugmeler[i].focus();
    };
    sekme.hidden = false;
    sec(0);
    dugmeler.forEach((d, i) => d.addEventListener("click", () => sec(i)));
    sekme.addEventListener("keydown", (e) => {
      const n = dugmeler.length;
      const yeni = e.key === "ArrowRight" ? (etkin + 1) % n : e.key === "ArrowLeft" ? (etkin - 1 + n) % n : e.key === "Home" ? 0 : e.key === "End" ? n - 1 : -1;
      if (yeni >= 0) { e.preventDefault(); sec(yeni, true); }
    });

    const ara = document.querySelector<HTMLInputElement>("#panorama-ara")!;
    ara.closest<HTMLElement>(".p-arama")!.hidden = false;
    ara.addEventListener("input", () => {
      if (!ara.value.trim()) {
        sekme.hidden = false;
        paneller.forEach((p) => p.querySelectorAll<HTMLElement>("[data-ara]").forEach((k) => { k.hidden = false; }));
        sec(etkin);
        document.getElementById("p-sonuc")!.replaceChildren();
        return;
      }
      sekme.hidden = true;
      let toplam = 0;
      for (const bolum of paneller) {
        let adet = 0;
        for (const kart of bolum.querySelectorAll<HTMLElement>("[data-ara]")) {
          kart.hidden = !eslesir(kart.dataset.ara!, ara.value);
          if (!kart.hidden) adet++;
        }
        bolum.hidden = !adet;
        toplam += adet;
      }
      const sonuc = document.getElementById("p-sonuc")!;
      sonuc.replaceChildren(document.createTextNode(ara.value ? toplam + " gösterge eşleşti. " : ""));
      const ilk = document.querySelector<HTMLElement>("section.tema:not([hidden]) h3");
      if (ara.value && ilk) {
        const git = document.createElement("a");
        git.href = "#" + ilk.id;
        git.textContent = "Sonuçlara git";
        sonuc.append(git);
      }
    });
  </script>
</Taban>
<style>
  .giris { padding-block: clamp(1.15rem, 3vw, 2.25rem) 0; }
  .giris-izgara { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center;
    padding: clamp(1.5rem, 4vw, 3.25rem); border-radius: 1.15rem; background: #111c2e; color: #f2f6fb; }
  .panorama-etiket { color: #82dac5; }
  .giris-metin h1 { font-size: clamp(2.35rem, 4.25vw, 4.25rem); letter-spacing: -.045em; line-height: 1.03; max-width: 16ch; margin: .8rem 0; text-wrap: unset; }
  .giris-metin .ozet { color: #becade; font-size: clamp(.98rem, 1.25vw, 1.1rem); max-width: 46ch; margin: 0 0 1.4rem; }
  .gezgin-cta { display: flex; flex-wrap: wrap; gap: .55rem; }
  .gezgin-cta a { display: inline-flex; align-items: center; gap: .65rem; min-height: 2.65rem; padding: .45rem .8rem; border: 1px solid #566783; border-radius: .55rem; font-size: .87rem; font-weight: 650; text-decoration: none; }
  .gezgin-cta a:first-child { background: #b7f1df; color: #102b24; border-color: #b7f1df; }
  .gezgin-cta a:hover { color: #fff; background: #2b3c55; }
  .gezgin-cta a:focus-visible, .kapsam a:focus-visible { outline-color: #b7f1df; }
  .kapsam { min-width: 0; padding: clamp(.9rem, 2.6vw, 1.5rem); background: #1a2840; border: 1px solid #3e506c; border-radius: .9rem; }
  .kapsam-ust { display: flex; flex-wrap: wrap; gap: .2rem .75rem; align-items: baseline; justify-content: space-between; }
  .kapsam-ust h2 { font-size: 1.06rem; }
  .kapsam-ust a { color: #c4d4eb; font-size: .8rem; }
  .kapsam-ust a:hover { color: #fff; }
  .durum { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.36fr) minmax(0, .75fr); gap: .5rem; margin: 1.1rem 0 .7rem; }
  .durum div { display: grid; align-content: start; gap: .15rem; }
  .durum dt { font-size: .75rem; color: #c4d4eb; }
  .durum dd { margin: 0; grid-row: 1; font-size: clamp(1.15rem, 2.2vw, 1.8rem); font-weight: 720; line-height: 1.2; letter-spacing: -.025em; }
  .kapsam-kurum, .kapsam-kontrol, .saglik-not { color: #c4d4eb; margin: 0; font-size: .8rem; }
  .kapsam-kontrol { margin-top: .8rem; padding-top: .7rem; border-top: 1px solid #465a77; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .2rem .6rem; }
  .kapsam-kontrol strong { color: #f2f6fb; }
  .saglik-not { margin-top: .4rem; color: #ffd0a8; }
  .kpiler { padding-block: 1.65rem 0; }
  .bolum-baslik { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .3rem 1rem; margin-bottom: .7rem; }
  .bolum-baslik .ozet { margin: 0; font-size: .85rem; }
  .kpi-izgara { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 36rem) { .kpi-izgara { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
