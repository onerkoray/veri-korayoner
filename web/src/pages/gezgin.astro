---
// Veri gezgini: panel veri seti (yıl / çeyrek / ay) üzerinde etkileşimli pano.
// Sunucuda: veri seti kataloğu (JS'siz okunur, dizinlenir). Tarayıcıda: gezgin.ts
// /api/v1/panel/{sıklık}.json dosyasını okur; durum adresin # kısmında tutulur.
import Taban from "../layouts/Taban.astro";
import "../styles/secim.css";
import { seriler, kaynaklar, TEMA, TEMA_SIRA, siklikAdi, tarih, uretildi, dolu } from "../lib/veri";
import { donemAdi } from "../lib/okuma.ts";
import { KISI_REF } from "../lib/kimlik";

const ss = seriler();
const SIRA = ["gunluk", "haftalik", "aylik", "ceyreklik", "yariyillik", "yillik"];
const var_ = (s: (typeof ss)[number], h: string) => s.izin.indirme && SIRA.indexOf(h) >= SIRA.indexOf(s.siklik);
const gruplar = TEMA_SIRA.map((t) => ({ t, ad: TEMA[t], liste: ss.filter((s) => s.tema === t) })).filter((g) => g.liste.length);
const yillar = ss.flatMap((s) => { const d = dolu(s); return d.length ? [Number(d[0].donem.slice(0, 4)), Number(d.at(-1)!.donem.slice(0, 4))] : []; });
const ilkYil = Math.min(...yillar), sonYil = Math.max(...yillar);
const panelSayisi = ss.filter((s) => s.izin.indirme).length;
const panelKaynak = kaynaklar().filter((k) => ss.some((s) => s.izin.indirme && s.kaynak.id === k.id));
const kisaAd = (k: string) => k.replace(/\s*\(.*\)$/, "").replace("Uluslararası Ödemeler Bankası", "BIS").replace("Avrupa Birliği İstatistik Ofisi", "Eurostat").replace("Uluslararası Çalışma Örgütü", "ILO");
const kaynakListesi = new Intl.ListFormat("tr", { type: "conjunction" }).format(panelKaynak.map((k) => kisaAd(k.kurum)));
const kurumlar = [...new Set(ss.map((s) => kisaAd(s.kaynak.kurum).replace("Avrupa Merkez Bankası", "ECB")))].sort((a, b) => a.localeCompare(b, "tr"));
const sikliklar = SIRA.filter((h) => ss.some((s) => s.siklik === h));
const site = "https://veri.korayoner.dev";
const jsonld = {
  "@context": "https://schema.org", "@type": "Dataset",
  name: "Türkiye makroekonomik panel veri seti (aylık, çeyreklik, yıllık)",
  description: `${kaynakListesi} kaynaklı ${panelSayisi} Türkiye serisi tek panelde: her seri kendi sıklığında ve daha seyrek sıklıklarda dönem ortalaması ile dönem sonu değeri, eksik dönem işaretiyle. ${ilkYil}–${sonYil}.`,
  url: `${site}/gezgin`, inLanguage: "tr", isAccessibleForFree: true,
  temporalCoverage: `${ilkYil}/${sonYil}`, spatialCoverage: { "@type": "Country", name: "Türkiye" },
  creator: KISI_REF, maintainer: KISI_REF,
  // Tek lisans yok: her seri kendi kaynağının şartlarıyla yayımlanır; tablo hepsini listeler.
  license: `${site}/kaynaklar#lisanslar`,
  isBasedOn: panelKaynak.map((k) => k.adres),
  variableMeasured: ss.filter((s) => s.izin.indirme).map((s) => s.baslik),
  distribution: ["aylik", "ceyreklik", "yillik"].flatMap((h) => [
    { "@type": "DataDownload", name: `${siklikAdi(h)} panel (CSV, geniş)`, encodingFormat: "text/csv", contentUrl: `${site}/api/v1/panel/${h}.csv` },
    { "@type": "DataDownload", name: `${siklikAdi(h)} panel (JSON, ortalama + dönem sonu + eksik işareti)`, encodingFormat: "application/json", contentUrl: `${site}/api/v1/panel/${h}.json` },
  ]),
  dateModified: uretildi().slice(0, 10),
};
---
<Taban baslik="Veri gezgini — Türkiye makroekonomik panel veri seti | Türkiye Verisi" aciklama={`Türkiye'nin ${panelSayisi} makroekonomik serisi yıl, çeyrek ve ay düzeyinde: göstergeleri seçin, karşılaştırın, yıl×ay tablosunda görün, CSV indirin. Kaynak: ${kaynakListesi}.`} yol="/gezgin" jsonld={jsonld}>
  <div class="sar gezgin">
    <header class="g-bas">
      <p class="etiket">Türkiye Verisi / Araştırma çalışma alanı</p>
      <h1>Veri gezgini</h1>
      <p class="ozet">Makroekonomik serileri aynı dönemlerde karşılaştırın, veri kapsamını inceleyin ve çalışmanızı dışa aktarın.</p>
      <p class="g-kunye"><strong>{panelSayisi} seri</strong> · {ilkYil}–{sonYil} · {kaynakListesi} <a href="/yontem">Veri yöntemi ↗</a></p>
    </header>

    <div class="g-calisma">
    <form class="g-kontrol" id="g-form" aria-label="Gezgin ayarları" hidden>
      <div class="g-kontrol-bas"><h2>Analiz ayarları</h2><button type="button" class="secim-eylem" id="g-sonuca-git" hidden>Sonuçlara git ↓</button></div>
      <fieldset class="g-gostergeler">
        <legend>Göstergeler <span class="g-sayac" id="g-sayac"></span></legend>
        <div class="g-ara">
          <label class="secim-alani g-ara-tam"><span class="gizli">Gösterge ara</span>
            <input class="secim-girdi" type="search" id="g-ara" placeholder="Gösterge adı veya seri kodu" autocomplete="off" enterkeyhint="search" />
          </label>
          <label class="secim-alani"><span class="secim-etiket">Kurum</span><span class="secim-kutu">
            <select id="g-kurum" aria-label="Kuruma göre süz"><option value="">Tüm kurumlar</option>{kurumlar.map((k) => <option value={k}>{k}</option>)}</select>
          </span></label>
          <label class="secim-alani"><span class="secim-etiket">Tema</span><span class="secim-kutu">
            <select id="g-tema-sec" aria-label="Temaya göre süz"><option value="">Tüm temalar</option>{gruplar.map((g) => <option value={g.t}>{g.ad}</option>)}</select>
          </span></label>
          <label class="secim-alani g-ara-tam"><span class="secim-etiket">Kaynak sıklığı</span><span class="secim-kutu">
            <select id="g-ssuz" aria-label="Kaynak sıklığına göre süz"><option value="">Tüm sıklıklar</option>{sikliklar.map((h) => <option value={h}>{siklikAdi(h)}</option>)}</select>
          </span></label>
          <div class="g-suz-eylem g-ara-tam">
            <button class="secim-eylem" type="button" id="g-yalniz-secili" aria-pressed="false" aria-controls="g-liste">Yalnız seçili</button>
            <button class="secim-eylem" type="button" id="g-temizle" disabled>Filtreleri temizle</button>
          </div>
          <span id="g-ara-sonuc" class="g-not g-ara-tam" role="status"></span>
        </div>
        <details class="g-acilir" id="g-liste" open data-ilk>
        <summary>Gösterge listesi <span id="g-liste-sayac">{ss.length} seri</span></summary>
        <div class="g-temalar">
          {gruplar.map((g) => (
            <div class="g-tema">
              <p>{g.ad}</p>
              {g.liste.map((s) => (
                <label class:list={["g-sec", !s.izin.indirme && "kapali"]} data-tema={g.t} data-arama={`${g.ad} ${s.id} ${s.kaynak_kod} ${s.kaynak.id} ${s.kaynak.kurum} ${s.kaynak_adi ?? ""}`} data-siklik={s.siklik} data-kurum={kisaAd(s.kaynak.kurum).replace("Avrupa Merkez Bankası", "ECB")}>
                  <input type="checkbox" name="g" value={s.id} disabled={!s.izin.indirme} />
                  <span>{s.baslik}</span>
                  <small>{kisaAd(s.kaynak.kurum).replace("Avrupa Merkez Bankası", "ECB")} · {siklikAdi(s.siklik).toLowerCase()}{!s.izin.indirme && " · yalnız gösterim"}<span class="g-uygunluk" hidden> · Seçili sıklıkta yok</span></small>
                </label>
              ))}
            </div>
          ))}
        </div>
        </details>
      </fieldset>
      <div class="g-satir">
        <fieldset class="g-dugme g-dugme-3"><legend>Analiz sıklığı</legend>
          {["aylik", "ceyreklik", "yillik"].map((h, i) => <label><input type="radio" name="s" value={h} checked={i === 0} /><span>{siklikAdi(h)}</span></label>)}
        </fieldset>
        <fieldset class="g-dugme"><legend>Değer hesabı</legend>
          <label><input type="radio" name="d" value="ort" checked /><span>Dönem ortalaması</span></label>
          <label><input type="radio" name="d" value="son" /><span>Dönem sonu</span></label>
        </fieldset>
        <fieldset class="g-aralik"><legend>Dönem aralığı</legend>
          <div class="g-donem-kutulari">
            <div class="secim-alani"><label class="secim-etiket" for="g-b">Başlangıç yılı</label><span class="secim-kutu"><select name="b" id="g-b">{Array.from({ length: sonYil - ilkYil + 1 }, (_, i) => ilkYil + i).map((y) => <option value={y} selected={y === 2010}>{y}</option>)}</select></span></div>
            <div class="secim-alani"><label class="secim-etiket" for="g-e">Bitiş yılı</label><span class="secim-kutu"><select name="e" id="g-e">{Array.from({ length: sonYil - ilkYil + 1 }, (_, i) => ilkYil + i).map((y) => <option value={y} selected={y === sonYil}>{y}</option>)}</select></span></div>
          </div>
          <div class="g-alt-donem" id="g-alt-donem" hidden>
            <div class="secim-alani"><label class="secim-etiket" id="g-p-ad" for="g-p">Başlangıç ayı</label><span class="secim-kutu"><select name="p" id="g-p"></select></span></div>
            <div class="secim-alani"><label class="secim-etiket" id="g-q-ad" for="g-q">Bitiş ayı</label><span class="secim-kutu"><select name="q" id="g-q"></select></span></div>
          </div>
          <div class="g-hizli" aria-label="Hazır dönemler">
            <button type="button" data-g-yil="1">Son 1 yıl</button>
            <button type="button" data-g-yil="3">Son 3 yıl</button>
            <button type="button" data-g-yil="5">Son 5 yıl</button>
            <button type="button" data-g-yil="10">Son 10 yıl</button>
            <button type="button" data-g-yil="0">Tümü</button>
          </div>
        </fieldset>
        <fieldset class="g-dugme" aria-describedby="g-olcek-not"><legend>Grafik ölçeği</legend>
          <label title="Kaynaktaki ölçek"><input type="radio" name="o" value="deger" checked /><span>Değer</span></label>
          <label title="Aynı birimdeki serileri tek eksende gösterir"><input type="radio" name="o" value="ortak" /><span>Aynı eksen</span></label>
          <label title="Düzey serileri ortak baz dönemine göre (baz = 100), tek eksende"><input type="radio" name="o" value="endeks" /><span>Baz = 100</span></label>
          <label title="Yüzde serileri baz döneme göre yüzde puan farkı, tek eksende"><input type="radio" name="o" value="fark" /><span>Fark (puan)</span></label>
        </fieldset>
        <p id="g-olcek-not" class="g-not g-olcek-not"></p>
        <fieldset class="g-dugme"><legend>Görünüm</legend>
          <label><input type="radio" name="v" value="grafik" checked /><span>Grafik</span></label>
          <label><input type="radio" name="v" value="isi" /><span>Yıl × dönem</span></label>
          <label><input type="radio" name="v" value="tablo" /><span>Tablo</span></label>
          <label><input type="radio" name="v" value="analiz" /><span>İstatistik</span></label>
        </fieldset>
      </div>
      <div class="g-eylem" role="group" aria-label="Dışa aktarma">
        <button type="button" class="g-indir" id="g-indir">CSV indir</button>
        <button type="button" class="g-indir ikincil" id="g-json">JSON indir</button>
        <button type="button" class="g-indir ikincil" id="g-meta" title="Her sütunun kaynağı, lisansı ve türetilmiş olup olmadığı">Metaveri (JSON)</button>
        <button type="button" class="g-indir ikincil" id="g-bagla">Bağlantıyı kopyala</button>
      </div>
    </form>
    <script is:inline src="/gezgin-erken.js"></script>
    <section class="g-sonuclar" aria-label="Analiz sonuçları">
      <div class="g-sonuc-ust" id="g-sonuc-ust" hidden>
        <h2 id="g-gorunum-bas" tabindex="-1">Zaman serileri</h2>
        <p class="g-durum" id="g-durum" role="status" aria-live="polite"></p>
        <ul id="g-secili" class="g-secili" aria-label="Seçili göstergeler"></ul>
      </div>
      <div id="g-cikti" class="g-cikti" data-bekle></div>
    </section>
    </div>
    <noscript><p class="ozet">Etkileşimli gezgin JavaScript gerektirir. Veri setinin tamamı aşağıdaki bağlantılardan CSV ve JSON olarak indirilebilir.</p></noscript>

    <section class="g-katalog" aria-labelledby="kat">
      <h2 id="kat">Veri seti kataloğu</h2>
      <p class="ozet">Her seri kendi sıklığında kaynaktaki değeriyle durur; daha seyrek sıklıklarda dönem ortalaması ve dönem sonu değeri bu sitenin hesabıdır. Yıllık seriden aylık değer üretilmez. Eksik dönem (ör. henüz 9 ayı açıklanmış yıl) JSON'da işaretlidir; geniş CSV'ye yalnız tam dönemler girer. Son kontrol: {tarih(uretildi())}.</p>
      <ul class="indir">
        {["aylik", "ceyreklik", "yillik"].map((h) => <li><a href={`/api/v1/panel/${h}.csv`} download>{siklikAdi(h)} CSV</a></li>)}
        {["aylik", "ceyreklik", "yillik"].map((h) => <li><a href={`/api/v1/panel/${h}.json`}>{siklikAdi(h)} JSON</a></li>)}
      </ul>
      <div class="kaydir">
        <table>
          <thead><tr><th scope="col">Gösterge</th><th scope="col">Kaynak</th><th scope="col">Kapsam</th><th scope="col" class="n">Gözlem</th><th scope="col">Aylık</th><th scope="col">Çeyreklik</th><th scope="col">Yıllık</th></tr></thead>
          <tbody>
            {ss.map((s) => { const d = dolu(s); return (
              <tr>
                <th scope="row"><a href={`/gosterge/${s.id}`}>{s.baslik}</a></th>
                <td>{s.kaynak.kurum.replace(/\s*\(.*\)$/, "")}</td>
                <td class="kucuk-h">{d[0] && donemAdi(d[0].donem)} – {d.at(-1) && donemAdi(d.at(-1)!.donem)}</td>
                <td class="n">{d.length.toLocaleString("tr-TR")}</td>
                {["aylik", "ceyreklik", "yillik"].map((h) => <td class="kucuk-h">{!s.izin.indirme ? "yalnız gösterim" : !var_(s, h) ? "—" : s.siklik === h ? "kaynak" : "türetilmiş"}</td>)}
              </tr>
            ); })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Taban>
<script>
  import "../scripts/gezgin.ts";
</script>
<style is:global>
  .gezgin { display: grid; gap: 1.2rem; padding-block: clamp(1.2rem, 3vw, 2.5rem) 0; }
  .g-bas { display: grid; gap: .45rem; padding-bottom: .9rem; border-bottom: 2px solid var(--metin); }
  .g-bas h1 { font: 650 clamp(2.2rem, 4.1vw, 3.55rem)/1 Georgia, "Times New Roman", serif; letter-spacing: -.045em; }
  .g-bas .ozet, .g-kunye { margin: 0; }
  .g-kunye { display: flex; flex-wrap: wrap; column-gap: .4rem; font-size: .79rem; color: var(--soluk); }
  .g-kunye a { margin-inline-start: .35rem; }
  .g-calisma { display: grid; grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); gap: 1.3rem; align-items: start; }
  .g-kontrol { display: grid; gap: 1rem; background: var(--yuzey); border: 1px solid var(--cizgi); border-radius: .45rem; padding: .9rem; min-width: 0; }
  .g-kontrol[hidden], .g-sonuc-ust[hidden] { display: none; }
  .g-kontrol-bas { display: flex; justify-content: space-between; align-items: center; gap: .25rem .65rem; flex-wrap: wrap; border-bottom: 1px solid var(--cizgi); padding-bottom: .65rem; }
  .g-kontrol-bas h2 { margin: 0; color: var(--metin); font-size: 1.09rem; letter-spacing: 0; }
  @media (min-width: 56.01rem) { #g-sonuca-git { display: none; } }
  .g-sonuclar { min-width: 0; }
  .g-sonuc-ust { display: grid; gap: .3rem; margin-bottom: .8rem; padding: .2rem 0 .65rem; border-bottom: 1px solid var(--cizgi); }
  .g-secili { list-style: none; display: flex; flex-wrap: wrap; gap: .25rem .4rem; margin: .2rem 0 0; padding: 0; }
  .g-secili:empty { display: none; }
  .g-secili li { min-width: 0; }
  .g-secim-kaldir { display: flex; align-items: center; gap: .5rem; min-height: 2.25rem; padding: .22rem .45rem;
    border: 1px solid var(--cizgi); border-radius: .3rem; background: var(--yuzey); color: var(--metin);
    font: 600 .75rem/1.35 var(--font); text-align: start; cursor: pointer; }
  .g-secim-kaldir:hover { border-color: var(--soluk); background: var(--yuzey-2); }
  .g-secim-kaldir span[aria-hidden] { margin-inline-start: auto; color: var(--soluk); font-size: 1.1rem; line-height: 1; }
  .g-hizli { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .55rem; }
  .g-donem-kutulari, .g-alt-donem:not([hidden]) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .4rem; }
  .g-alt-donem:not([hidden]) { margin-top: .45rem; }
  .g-hizli button { min-height: 2rem; padding: .15rem .38rem; border: 1px solid var(--cizgi); border-radius: .25rem;
    background: var(--yuzey); color: var(--soluk); font: 600 .72rem/1.25 var(--font); cursor: pointer; }
  .g-hizli button:hover { border-color: var(--soluk); }
  .g-hizli button[aria-pressed="true"] { border-color: var(--marka); box-shadow: inset 0 -2px var(--marka); color: var(--metin); }
  .g-istatistik { font-size: .82rem; min-width: 43rem; }
  .g-istatistik td, .g-istatistik th { padding: .48rem .55rem; }
  .g-istatistik small { display: block; color: var(--soluk); font-weight: 400; }
  .g-korelasyon { min-width: min(100%, 29rem); font-size: .84rem; }
  .g-istatistik-panel { display: grid; gap: .6rem; }
  .g-istatistik-panel h3 { font-size: 1.07rem; }
  .g-istatistik-panel p { margin: 0; }
  .g-iliski-etiket { font-size: .78rem; font-weight: 650; }
  #g-iliski-cift { width: min(100%, 31rem); background: var(--bg); color: var(--metin); border: 1px solid var(--cizgi); padding: .45rem; font: inherit; font-size: .85rem; }
  .g-iliski-grafik svg { display: block; max-width: 100%; height: auto; }
  .g-korelasyon td:nth-child(3) { font-family: var(--mono); font-weight: 700; }
  .g-korelasyon .iliski-cubuk { display: inline-block; vertical-align: middle; width: 3.25rem; height: .38rem; background: var(--yuzey-2); margin-inline-start: .35rem; }
  .iliski-cubuk span { display: block; height: 100%; background: var(--dv-1); }
  .iliski-cubuk[data-eksi] span { background: var(--dv-kotu); }
  @media (max-width: 56rem) { .g-calisma { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
  .g-kontrol fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .g-kontrol legend { font: 700 .8rem/1.4 var(--font); color: var(--metin); margin-bottom: .45rem; padding: 0; }
  .g-sayac { text-transform: none; letter-spacing: 0; font-weight: 500; }
  .g-acilir { border: 1px solid var(--cizgi); border-radius: .36rem; }
  .g-acilir > summary { padding: .6rem; font: 700 .8rem/1.4 var(--font); cursor: pointer; }
  .g-acilir[open] > summary { border-bottom: 1px solid var(--cizgi); }
  .g-acilir summary span { float: inline-end; color: var(--soluk); font: 550 .72rem/1.55 var(--mono); }
  .g-acilir summary:hover { background: var(--yuzey-2); }
  .g-temalar { display: grid; gap: .7rem; max-height: clamp(12rem, 37vh, 19rem); overflow: auto; padding: .5rem; }
  .g-tema > p { margin: 0 0 .25rem; padding: .2rem .3rem; color: var(--soluk); font: 650 .74rem/1.4 var(--font); }
  .g-sec { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 .48rem; align-items: start;
    padding: .34rem .3rem; border: 1px solid transparent; border-radius: .26rem; cursor: pointer; font-size: .82rem; line-height: 1.35; }
  .g-sec:hover { background: var(--yuzey-2); }
  .g-sec:has(input:checked) { border-color: var(--cizgi); background: var(--yuzey-2); }
  .g-sec input { margin: .15rem 0 0; accent-color: var(--dv-1); }
  .g-sec small { grid-column: 2; color: var(--soluk); font-size: .72rem; }
  .g-sec.kapali { color: var(--soluk); cursor: not-allowed; }
  .g-uygunluk { font-weight: 650; }
  .g-satir { display: grid; grid-template-columns: minmax(0, 1fr); gap: .86rem; border-top: 1px solid var(--cizgi); padding-top: .85rem; }
  .g-dugme { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .3rem; }
  .g-dugme-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .g-dugme label { position: relative; min-width: 0; }
  .g-dugme input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .g-dugme span { display: flex; align-items: center; justify-content: center; height: 100%; min-height: 2.45rem;
    padding: .35rem .25rem; border: 1px solid var(--cizgi); border-radius: .28rem; color: var(--soluk);
    font: 650 .76rem/1.3 var(--font); text-align: center; }
  .g-dugme label:hover span { border-color: var(--soluk); }
